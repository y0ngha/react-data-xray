{
  "name": "react-data-xray",
  "version": "0.1.0",
  "description": "Dev-only React devtools: click a value on screen to see which API response field it came from, and find wasted requests and renders",
  "keywords": [
    "react",
    "devtools",
    "debugging",
    "fetch",
    "xhr",
    "api",
    "network",
    "performance",
    "re-render",
    "react-query"
  ],
  "author": "y0ngha",
  "homepage": "https://github.com/y0ngha/react-data-xray#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/y0ngha/react-data-xray.git"
  },
  "bugs": {
    "url": "https://github.com/y0ngha/react-data-xray/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/server/vite.d.ts",
      "default": "./dist/server/vite.js"
    },
    "./middleware": {
      "types": "./dist/server/middleware.d.ts",
      "default": "./dist/server/middleware.js"
    },
    "./next": {
      "types": "./dist/server/next.d.ts",
      "default": "./dist/server/next.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/core/render/monitor.js"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "fmt": "oxfmt src scripts",
    "fmt:check": "oxfmt --check src scripts",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:react && pnpm fmt:check && pnpm test:coverage && pnpm test:react19",
    "sync": "pnpm build && node scripts/sync-to-app.mjs",
    "check:side-effects": "pnpm build && node scripts/check-side-effects.mjs",
    "lint:react": "react-doctor . --no-supply-chain --no-telemetry -y",
    "test:react19": "vitest run --config vitest.react19.config.ts",
    "prepublishOnly": "pnpm check && pnpm check:side-effects"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^18.3.1",
    "react-doctor": "^0.9.18",
    "react-dom": "^18.3.1",
    "rolldown": "^1.2.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
