{
  "name": "react-data-xray",
  "version": "0.1.0",
  "description": "화면의 React 컴포넌트가 어느 API 응답을 보여 주는지 찾아 주는 dev 전용 devtools",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/server/vite.d.ts",
      "import": "./dist/server/vite.js"
    },
    "./middleware": {
      "types": "./dist/server/middleware.d.ts",
      "import": "./dist/server/middleware.js"
    }
  },
  "files": [
    "dist",
    "skills"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "fmt": "oxfmt src scripts",
    "fmt:check": "oxfmt --check src scripts",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:react && pnpm fmt:check && pnpm test:coverage",
    "sync": "pnpm build && node scripts/sync-to-app.mjs",
    "lint:react": "react-doctor . --no-supply-chain --no-telemetry -y"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitest/coverage-v8": "5.0.5",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^18.3.1",
    "react-doctor": "^0.9.18",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
